# === VideoNote runtime config ===
# Copy this file to .env and fill in real values. .env is git-ignored.

# --- LLM (text reasoning) ---
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=gpt-5.5

# --- VLM (vision + multimodal) ---
# Leave blank to reuse LLM_* values above.
VLM_API_KEY=
VLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
VLM_MODEL=mimo-v2.5

# --- ASR (audio transcription) ---
# If your provider does not implement Whisper-compatible audio.transcriptions,
# set ASR_ENABLED=false. The engine will then build notes from VLM + filename
# only, without ever calling Whisper. Default: false (safe for mimo / generic
# OpenAI-compatible endpoints that don't host whisper-1).
ASR_ENABLED=false
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1

# --- Server ---
VIDEONOTE_HOST=0.0.0.0
VIDEONOTE_PORT=8000

# Max concurrent video pipelines (each can use CPU + ffmpeg + 2 API calls)
MAX_CONCURRENT_TASKS=3
