# === VideoNote runtime config ===
# Copy this file to .env and fill in real values. .env is git-ignored.

# --- LLM (text reasoning) ---
LLM_API_KEY=
LLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
LLM_MODEL=gpt-5.5

# --- VLM (vision + multimodal) ---
# Leave blank to reuse LLM_* values above.
VLM_API_KEY=
VLM_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
VLM_MODEL=mimo-v2.5

# --- ASR (audio transcription) ---
# If your provider does not implement Whisper-compatible audio.transcriptions,
# set ASR_ENABLED=false. The engine will then build notes from VLM + filename
# only, without ever calling Whisper. Default: false (safe for mimo / generic
# OpenAI-compatible endpoints that don't host whisper-1).
ASR_ENABLED=false
ASR_API_KEY=
ASR_BASE_URL=
ASR_MODEL=whisper-1

# --- RAG embeddings ---
# SiliconFlow OpenAI-compatible embeddings. Keep the real key only in .env.
EMBEDDING_PROVIDER=siliconflow
SILICONFLOW_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSION=1024
EMBEDDING_FALLBACK_LOCAL=true

# --- Server ---
VIDEONOTE_HOST=0.0.0.0
VIDEONOTE_PORT=8000

# Max concurrent video pipelines (each can use CPU + ffmpeg + 2 API calls)
MAX_CONCURRENT_TASKS=2

# --- Production access control ---
# Set both values before exposing the service. Leave blank only for local development.
VIDEONOTE_AUTH_PASSWORD=
VIDEONOTE_SESSION_SECRET=
VIDEONOTE_COOKIE_SECURE=true
VIDEONOTE_DOMAIN=note.example.com
ALLOW_RUNTIME_PROVIDER_KEYS=false
ALLOW_RUNTIME_PROVIDER_CONFIG=false
CORS_ORIGINS=https://your-domain.example

# --- Resource and cost limits ---
MAX_UPLOAD_BYTES=536870912
MAX_VIDEO_DURATION_SECONDS=3600
